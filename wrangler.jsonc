{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trucostats",
  "account_id": "05bb47daad6508fed7a3a1d1e08f6759",
  "compatibility_date": "2026-10-17",
  // Código del backend (Worker).
  "main": "worker/index.ts",
  // Dirección pública de la app: los enlaces de los correos apuntan acá. Las
  // claves del correo (BREVO_API_KEY y MAIL_FROM) no van en este archivo: se
  // cargan con `npx wrangler secret put`.
  "vars": {
    "APP_URL": "https://trucostats.guzmandls.workers.dev",
  },
  // El Worker corre junto a la base de datos (que está en el este de EE.UU.):
  // cada pedido hace varias consultas seguidas y así cada una es casi
  // instantánea; queda un solo viaje largo, el del celular al Worker.
  "placement": {
    "mode": "targeted",
    "region": "aws:us-east-1",
  },
  // Base de datos D1. El Worker la usa como env.DB.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trucostats-db",
      "database_id": "4aca6236-9c06-4837-81f9-e3f0872af0e0",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Las rutas /api/* las atiende el Worker; el resto, la app (archivos de dist).
    "run_worker_first": ["/api/*"],
  },
}
